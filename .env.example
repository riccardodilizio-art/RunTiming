# Copia questo file in ".env" (stessa cartella di docker-compose.yml) e compila.
# Il file .env è git-ignored: chiavi e password NON vanno mai nel repository.

# OBBLIGATORIO. Segreto casuale per i login (almeno 32 caratteri). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Password del database (solo server: docker-compose.prod.yml). Lunga e casuale.
POSTGRES_PASSWORD=

# Admin iniziale (solo al primo avvio, poi si possono togliere)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Il sito usa il backend (true) o la demo locale (false)
VITE_USE_API=true

# PayPal (sandbox per le prove, live per i soldi veri)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# FIDAL / WISE
WISE_USERNAME=
WISE_PASSWORD=

# Email con Amazon SES (datacenter di Milano). Vuote = nessuna email inviata.
# Le chiavi sono quelle dell'utente IAM con il solo permesso di inviare email.
SITE_URL=https://timingrun.it
MAIL_FROM=iscrizioni@timingrun.it
MAIL_FROM_NAME=Segreteria – TimingRun
# Dove arrivano le risposte degli atleti (la casella che leggete)
MAIL_REPLY_TO=
AWS_REGION=eu-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Facoltativi
# Proxy davanti al backend: 1 = solo nginx, 2 = Cloudflare + nginx, vuoto = nessuno.
# Sbagliarlo fa contare tutti i visitatori come uno solo nei limiti di richieste.
TRUST_PROXY=
RATE_LIMIT_PER_MIN=300
# Anti-bot Cloudflare Turnstile: entrambe vuote = disattivato
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
