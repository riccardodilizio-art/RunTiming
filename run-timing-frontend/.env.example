# URL base del backend API (lasciare vuoto per usare lo stesso host)
VITE_API_URL=http://localhost:3000
# true = il sito legge e scrive sul backend (eventi, iscrizioni, login staff).
# false/assente = prototipo dimostrativo su localStorage, senza server.
VITE_USE_API=false
# Solo modalità demo (VITE_USE_API=false): admin locale. Lasciare vuoto per nessun accesso admin.
VITE_DEMO_ADMIN_USER=
VITE_DEMO_ADMIN_PASSWORD=
# Chiave PUBBLICA Cloudflare Turnstile (anti-bot). Vuoto = disattivato.
VITE_TURNSTILE_SITE_KEY=
# Nome del sito (logo, titoli, testi). Cambiarlo qui basta per tutto il frontend.
VITE_SITE_NAME=RunTiming
# Email di contatto mostrata nella pagina Contatti
VITE_CONTACT_EMAIL=
