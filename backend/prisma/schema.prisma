// RunTiming — schema dati (modular monolith). Derivato da run-timing-frontend/src/types.
// Le parti flessibili (formSchema, priceSteps, categorie, commissioni, template
// attestato, roster) sono Json; le entità portanti sono relazionali.

generator client {
  provider      = "prisma-client-js"
  // "native" per lo sviluppo locale, target musl per l'immagine Docker (alpine)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  ATHLETE
  SOCIETY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum CertStatus {
  NON_RICHIESTO
  IN_ATTESA
  VERIFICATO
  RIFIUTATO
}

model Account {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  /// Incrementato a ogni cambio password: invalida i login già emessi
  tokenVersion    Int             @default(0)
  /// Account disattivato dall'admin (es. organizzatore che non collabora più): niente accesso
  disabled        Boolean         @default(false)
  role            Role
  displayName     String?
  assignedEventIds String[]       // eventi gestibili (organizer)
  createdAt       DateTime        @default(now())
  athlete         AthleteProfile?
  society         Society?
  createdEvents   Event[]         @relation("OrganizerEvents")
  passwordResets  PasswordReset[]
}

/// Link "password dimenticata": nel DB solo l'impronta del token, valido 1 ora, monouso.
model PasswordReset {
  id        String    @id @default(cuid())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

/// Coda delle email: si scrivono qui e un processo le invia (con nuovi tentativi
/// se il servizio non risponde). dedupeKey evita doppioni (es. un solo promemoria).
model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String
  kind      String    // iscrizione | pagamento | promemoria | annullamento | password
  dedupeKey String?   @unique
  status    String    @default("pending") // pending | sending | sent | failed | disabled
  attempts  Int       @default(0)
  lastError String?
  sendAfter DateTime  @default(now())
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, sendAfter])
}

model AthleteProfile {
  id            String         @id @default(cuid())
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String         @unique
  nome          String
  cognome       String
  dataNascita   DateTime
  sesso         String
  codFiscale    String?        @unique
  phone         String?
  club          String?
  certType      String?
  certExpiry    DateTime?
  certStatus    CertStatus?
  affiliations  Affiliation[]
  registrations Registration[]
}

model Affiliation {
  id            String          @id @default(cuid())
  athlete       AthleteProfile? @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athleteId     String?
  ente          String
  societaNome   String
  codiceSocieta String?
  numeroTessera String?
  certScadenza  DateTime?
  source        String?
}

model Society {
  id          String   @id @default(cuid())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String   @unique
  societaNome String
  ente        String
  codiceFidal String?
  /// Codice FIDAL approvato dall'admin: solo allora la società può importare
  /// gli atleti tesserati (l'account società si crea liberamente).
  fidalApproved Boolean @default(false)
  roster      Json     // RosterAthlete[]
  createdAt   DateTime @default(now())
}

model Event {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  category      String
  location      String
  city          String
  province      String
  lat           Float
  lng           Float
  coverImage    String?
  flyerUrl      String?
  regulationUrl String?
  description   String?
  isFeatured    Boolean    @default(false)
  isLive        Boolean    @default(false)
  organizer     String
  commission    Json?
  routeInfo     Json?
  /// Combinate: [{ id, nome, raceIds, prezzo }] — iscrizione a più gare con una quota sua
  combinate     Json?
  /// Cambi dopo l'iscrizione: { cambioGara, cessione (€ o null = no), trasferimento (€ o null = no) }
  quoteCambi    Json?
  /// Edizione precedente (evento copiato): per i crediti da trasferimento
  edizionePrecedenteId String?
  createdBy     Account?   @relation("OrganizerEvents", fields: [createdById], references: [id])
  createdById   String?
  days          EventDay[]
  createdAt     DateTime   @default(now())
}

model EventDay {
  id      String   @id @default(cuid())
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  date    DateTime
  label   String?
  races   Race[]
}

model Race {
  id                  String         @id @default(cuid())
  day                 EventDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId               String
  name                String
  distance            String
  raceType            String
  ente                String?
  /// Tesseramenti ammessi: fidal, runcard, eps, libero (vuoto = tutti)
  ammessi             String[]       @default([])
  /// Iscrizioni di gruppo delle società: { ogni: 10, gratis: 1 } (vuoto = nessun omaggio)
  gruppoOmaggi        Json?
  paymentMode         String?
  requiresMedicalCert Boolean        @default(false)
  minAge              Int?
  maxAge              Int?
  price               Float          @default(0)
  maxParticipants     Int            @default(0)
  isOpen              Boolean        @default(true)
  /// Chiusura automatica delle iscrizioni (es. giovedì 23:59 prima della gara); dopo, solo l'admin
  chiusuraIscrizioni  DateTime?
  /// Massimo di atleti che una società può iscrivere a questa gara (0 = nessun limite)
  maxPerSocieta       Int            @default(0)
  /// Primo pettorale della gara (assegnazione per società, poi cognome e nome)
  pettoraleDa         Int?
  formSchema          Json?
  priceSteps          Json?
  publicFields        String[]
  publicColumns       String[]
  categories          Json?
  commission          Json?
  certificateTemplate Json?
  /// Chiave segreta per il programma semi-live (invio classifiche dal PC di gara)
  syncKey             String?        @unique
  registrations       Registration[]
  resultRows          ResultRow[]
  paymentGroups       PaymentGroup[]
}

model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  type        String
  value       Float
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  /// Evento su cui vale il codice (vuoto = tutti gli eventi)
  eventId     String?
  /// Credito da trasferimento: vale solo sull'edizione successiva di questo evento
  creditoDaEventoId String?
}

model Registration {
  id               String          @id @default(cuid())
  race             Race            @relation(fields: [raceId], references: [id], onDelete: Cascade)
  raceId           String
  eventId          String
  athlete          AthleteProfile? @relation(fields: [athleteId], references: [id])
  athleteId        String?
  societyId        String?
  // Anagrafica "fotografata" al momento dell'iscrizione: serve per elenco
  // pubblico, ricerca, verifica iscrizione ed export senza leggere formData.
  cognome          String
  nome             String
  sesso            String
  dataNascita      DateTime?
  societa          String?
  codiceSocieta    String?
  tessera          String?
  /// Tesseramento con cui l'atleta si è iscritto: fidal, runcard, eps, libero
  tesseramento     String?
  email            String?
  formData         Json
  basePrice        Float           @default(0)
  discountAmount   Float           @default(0)
  commissionAmount Float           @default(0)
  /// Maggiorazione del metodo di pagamento (bonifico +1 €, PayPal/carta %): incasso della segreteria
  paymentFee       Float           @default(0)
  pricePaid        Float
  /// Codice pagamento univoco: causale del bonifico e chiave per pagare in seguito
  paymentRef       String?         @unique
  paypalOrderId    String?         @unique
  /// Importo e maggiorazione dell'ordine PayPal al momento della creazione: all'incasso
  /// si confronta con questi (non con le tariffe attuali, che l'admin può cambiare)
  paypalAmount     Float?
  paypalFee        Float?
  paidAt           DateTime?
  discountCode     String?
  paymentMethod    String?
  paymentStatus    PaymentStatus   @default(PENDING)
  assignedCategory String?
  fidalVerified    Boolean         @default(false)
  addedByOrganizer Boolean         @default(false)
  createdById      String?
  certStatus       CertStatus?
  submittedAt      DateTime        @default(now())
  /// Promemoria di pagamento già inviato (gare a pagamento anticipato)
  reminderSentAt   DateTime?
  /// Iscrizione di gruppo della società: si paga con il gruppo (un solo bonifico)
  group            PaymentGroup?   @relation(fields: [groupId], references: [id])
  groupId          String?
  /// Quota in omaggio (es. ogni 10 iscritti della società, uno gratis)
  omaggio          Boolean         @default(false)
  /// Combinata dell'evento a cui appartiene l'iscrizione (id in Event.combinate)
  combinataId      String?
  /// Iscrizione principale della combinata: si paga lì, le altre la seguono
  combinataParentId String?
  /// Pettorale (unico nell'evento)
  pettorale        Int?
  /// Codice segreto del link "gestisci iscrizione" (anche senza account)
  manageToken      String?         @unique
  /// Trasferita all'edizione dopo (credito emesso): non si riattiva
  trasferitoAt     DateTime?
  changes          RegChange[]

  @@index([raceId, cognome])
  @@index([eventId, cognome])
  @@index([societyId])
  @@index([athleteId])
  @@index([groupId])
  @@index([combinataParentId])
  @@unique([eventId, pettorale])
}

/// Cambio dopo l'iscrizione (cambio gara, cessione del pettorale, trasferimento all'anno dopo).
/// Se c'è da pagare si applica quando il pagamento arriva; altrimenti subito.
model RegChange {
  id             String        @id @default(cuid())
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String
  eventId        String
  /// gara | cessione | trasferimento
  tipo           String
  /// Dati del cambio (gara di arrivo, nuovo atleta…)
  dati           Json
  descrizione    String
  /// Differenza di quota o quota di segreteria (senza maggiorazione del metodo)
  importo        Float
  paymentFee     Float         @default(0)
  totale         Float
  paymentMethod  String?
  paymentStatus  PaymentStatus @default(PENDING)
  paymentRef     String?       @unique
  paypalOrderId  String?       @unique
  paypalAmount   Float?
  createdById    String?
  createdAt      DateTime      @default(now())
  paidAt         DateTime?
  appliedAt      DateTime?
  /// Risultato (es. codice del credito per l'anno dopo)
  esito          String?

  @@index([registrationId])
  @@index([paymentStatus])
}

/// Pagamento di gruppo: la società iscrive più atleti e paga con un solo bonifico.
model PaymentGroup {
  id            String         @id @default(cuid())
  race          Race           @relation(fields: [raceId], references: [id], onDelete: Cascade)
  raceId        String
  eventId       String
  societyId     String
  societaNome   String
  /// Codice per la causale del bonifico (come per le iscrizioni singole)
  paymentRef    String         @unique
  paymentMethod String
  paymentStatus PaymentStatus  @default(PENDING)
  iscritti      Int
  omaggi        Int
  /// Quota di un atleta (scaglione in vigore) e maggiorazione per ogni pagante
  quota         Float
  maggiorazione Float
  totale        Float
  createdById   String?
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  registrations Registration[]

  @@index([societyId])
  @@index([paymentStatus])
}

// Impostazioni globali (es. commissione di default) come chiave → JSON.
model Setting {
  key   String @id
  value Json
}

// Dataset FIDAL importato (lookup interno, no API esterna).
model FidalAthlete {
  tessera       String    @id
  tipo          String
  nome          String
  cognome       String
  dataNascita   DateTime?
  sesso         String
  societa       String
  codiceSocieta String
  certScadenza  DateTime?

  @@index([codiceSocieta])
}

// Anagrafica società FIDAL (codice → denominazione). Popolata dall'import del
// relativo dump; usata per mostrare il nome reale della società al posto del codice.
model FidalSociety {
  codice        String  @id
  denominazione String
  citta         String?
  provincia     String?
  regione       String?
  ente          String?
}

model ResultUpload {
  id            String      @id @default(cuid())
  raceId        String      @unique
  fileName      String
  columnMapping Json
  /// live = provvisoria (semi-live durante la gara), final = ufficiale
  status        String      @default("final")
  /// upload = Excel dall'admin, sync = programma semi-live
  source        String      @default("upload")
  uploadedAt    DateTime    @default(now())
  rows          ResultRow[]
}

model ResultRow {
  id       String       @id @default(cuid())
  upload   ResultUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId String
  race     Race?        @relation(fields: [raceId], references: [id])
  raceId   String?
  section  String?
  position Int
  data     Json

  @@index([raceId])
}
