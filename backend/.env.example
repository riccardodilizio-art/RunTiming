DATABASE_URL=postgresql://runtiming:runtiming@localhost:5432/runtiming
REDIS_URL=redis://localhost:6379
# OBBLIGATORIO: segreto casuale di almeno 32 caratteri (il server non parte con
# valori deboli come "change-me-in-prod"). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Primo avvio: crea l'account admin se non ne esiste nessuno (poi si possono togliere)
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Proxy davanti al backend (es. 1 con nginx/Cloudflare): serve a leggere l'IP reale
TRUST_PROXY=
# Limite di richieste al minuto per IP (login e iscrizioni hanno limiti più stretti)
RATE_LIMIT_PER_MIN=300
# Anti-bot Cloudflare Turnstile per iscrizioni senza account e nuovi account.
# Facoltativo: vuoto = disattivato. La chiave pubblica va nel frontend
# (VITE_TURNSTILE_SITE_KEY). MAI committare la chiave segreta.
TURNSTILE_SECRET_KEY=

# ─── Integrazione FIDAL / WISE (fidalservizi.it) ─────────────────────────────
# Proxy verso il gestionale WISE. Autenticazione via login ASP.NET Core Identity.
# ATTENZIONE: WISE è servito in HTTP (non cifrato) e l'automazione va concordata
# con FIDAL Servizi (Termini di Servizio).
# ─── Pagamenti PayPal (anche carte) ──────────────────────────────────────────
# Chiavi dell'app REST creata su developer.paypal.com (conto Business TimingRun).
# PAYPAL_ENV=sandbox per le prove, live per i soldi veri. MAI committare le chiavi.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

WISE_BASE_URL=http://wise.fidalservizi.it
WISE_USERNAME=
WISE_PASSWORD=
# Form di login WISE (valori osservati dal traffico reale). Le CREDENZIALI vanno
# in WISE_USERNAME/WISE_PASSWORD qui sopra — MAI committate.
WISE_LOGIN_PATH=/Admin/Account/LogIn
WISE_USER_FIELD=UserName
WISE_PASS_FIELD=Password
# In alternativa alle credenziali: cookie di sessione fisso (prototipo, scade).
WISE_COOKIE=
# Endpoint osservati dal traffico reale (override se cambiano).
WISE_ATLETA_PATH=/Iscrizioni/Iscritti/OngGetAtletaFidalByTessera
WISE_ATLETA_PARAM=tessera
WISE_SEARCH_PATH=/Iscrizioni/Iscritti/OngGetAtletaFidalByParametri
# NON ancora confermato dal traffico: ipotesi da verificare.
WISE_SOCIETY_PATH=/Iscrizioni/Iscritti/OngGetAtletiSocieta
